{
  "expo": {
    "name": "EasyShoppingMallBD",
    "slug": "easyshoppingmallbd",
    "scheme": "easyshoppingmallbd",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E5F4FD",
        "foregroundImage": "./assets/logo.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-secure-store",
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow EasyShoppingMallBD to select product and profile photos.",
          "microphonePermission": false
        }
      ],
      "expo-image",
      "expo-sharing",
      [
        "expo-media-library",
        {
          "photosPermission": "Allow EasyShoppingMallBD to access photos.",
          "savePhotosPermission": "Allow EasyShoppingMallBD to save product images.",
          "granularPermissions": [
            "photo"
          ]
        }
      ],
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/logo.png",
          "imageWidth": 100,
          "resizeMode": "contain",
          "backgroundColor": "#0092EE"
        }
      ]
    ]
  }
}
